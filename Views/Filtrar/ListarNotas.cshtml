@using System.ComponentModel.Design
@using System.Net.Mime
@model IEnumerable<ESCOLAT1.Models.Nota>

@{
    ViewData["Title"] = "Listar Notas";
}

<h1>Listar Notas</h1>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Disciplina.Curso)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Aluno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Disciplina)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Semestre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Valor)
            </th>
            <th>Qtde</th>
            <th>Total</th>
    
        </tr>
    </thead>
    <tbody>
        @{float soma =0;
          int qtreg=0; 
         }

        @foreach (var item in Model) {
        <tr>
            <td> 
                @Html.DisplayFor(modelItem => item.Disciplina.Curso.Descricao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Aluno.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Disciplina.Descricao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Semestre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Valor)
            </td>
             @{
                Random randon = new Random(); 
                int qtde = randon.Next(0,50); 
            }
            <td>
                @qtde.ToString("N2")
            </td>
            @{
                float total = qtde * item.Valor;  
                soma = soma + total; 
                qtreg++; 
            }
            <td>
                @total.ToString("N2")
            </td>

        </tr>
}
    </tbody>
</table>

@{ 
    float media = soma/qtreg;

    float somaNota = Model.Sum(n =>n.Valor); 
    int contReg = Model.Count();
    float medNota = somaNota / contReg; 
    float medNota2 = Model.Average(m => m.Valor); 
    float max = Model.Max(m => m.Valor); 
    float min = Model.Min(m => m.Valor); 
}

<h3>--------------------- Total Geral --------------</h3>
<h3>Total de registros: @qtreg.ToString("N2")</h3>
<h3>Soma de total: @soma.ToString("N2")</h3>
<h3>Média de Total: @media.ToString("N2")</h3>

<h4>--------------Total com base no atributo Valor -------------------</h4>
<h4>Soma Nota:  @somaNota </h4>
<h4>Total Registros: @contReg </h4>
<h4>Media Nota Calculo: @medNota </h4>
<h4>Média Nota Função Lambda: @medNota2 </h4>
<h4>Maior Nota: @max </h4>
<h4>Menor Nota: @min</h4>

<h3>Soma de notas por curso</h3>
